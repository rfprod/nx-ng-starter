{
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "outDir": "../../dist/libs/<%= kebabCaseName %>",
    "rootDir": "./src",
    "target": "ES2022",
    "tsBuildInfoFile": "../../dist/libs/<%= kebabCaseName %>/tsconfig.lib.tsbuildinfo"
  },
  "exclude": ["*.mts", "src/test-setup.ts", "**/*.spec.ts", "**/*.mock.ts"],
  "extends": "./tsconfig.json",
  "include": ["**/*.ts"],
  "references": []
}
