{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../dist/tools/ts",
    "tsBuildInfoFile": "../dist/tools/ts/tsconfig.ts-tools.tsbuildinfo",
    "target": "ES2022",
    "types": ["node"],
    "rootDir": "ts"
  },
  "exclude": ["vite.config.mts", "vitest.config.mts", "**/*.spec.ts"],
  "extends": "./tsconfig.json",
  "include": ["ts/**/*.ts"]
}
