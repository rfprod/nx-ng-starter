{
  "name": "nx-ng-starter-server",
  "private": true,
  "description": "Cloud Functions for Firebase",
  "main": "main.js",
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "dist:clean": "rm -rf ./main.js ./main.js.map ./*.txt ./schema.gql",
    "dist:get": "npm run dist:clear; cp -r ../dist/apps/api/* ./; cp ../libs/backend-gql/schema.gql ./",
    "logs": "firebase functions:log",
    "serve": "firebase serve --only functions",
    "shell": "firebase experimental:functions:shell",
    "start": "npm run shell",
    "start:emulators": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.1",
    "@nestjs/axios": "12.0.1",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/graphql": "14.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/microservices": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/platform-ws": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/websockets": "12.0.3",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/graphql-upload": "17.0.0",
    "@types/node": "25.9.2",
    "@types/websocket": "1.0.10",
    "@types/ws": "8.18.1",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.4.0",
    "google-protobuf": "4.0.2",
    "graphql": "17.0.2",
    "graphql-subscriptions": "3.0.0",
    "graphql-tag": "2.12.7",
    "graphql-tools": "9.0.35",
    "graphql-upload": "18.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "engines": {
    "node": ">=10",
    "npm": ">=6.14.4"
  }
}
