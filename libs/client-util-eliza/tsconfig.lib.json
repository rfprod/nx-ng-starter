{
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "outDir": "../../dist/libs/client-util-eliza",
    "rootDir": "./src",
    "target": "ES2022",
    "tsBuildInfoFile": "../../dist/libs/client-util-eliza/tsconfig.lib.tsbuildinfo",
    "useDefineForClassFields": false
  },
  "exclude": ["./src/test-setup.ts", "**/*.spec.ts", "**/*.mock.ts", "**/*.stories.ts", "*.mts"],
  "extends": "./tsconfig.json",
  "include": ["./src/**/*.ts"]
}
