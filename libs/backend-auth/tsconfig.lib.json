{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "../../dist/libs/backend-auth",
    "tsBuildInfoFile": "../../dist/libs/backend-auth/tsconfig.lib.tsbuildinfo",
    "rootDir": "./src"
  },
  "exclude": ["**/*.spec.ts", "*.mts"],
  "extends": "./tsconfig.json",
  "include": ["./src/**/*.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "references": [{ "path": "../backend-interfaces/tsconfig.lib.json" }]
}
