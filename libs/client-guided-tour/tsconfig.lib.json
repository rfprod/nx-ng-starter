{
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "outDir": "../../dist/libs/client-guided-tour",
    "tsBuildInfoFile": "../../dist/libs/client-guided-tour/tsconfig.lib.tsbuildinfo",
    "rootDir": "./src"
  },
  "exclude": ["*.mts", "./src/test-setup.ts", "**/*.spec.ts", "**/*.mock.ts"],
  "extends": "./tsconfig.json",
  "include": ["./src/**/*.ts"]
}
