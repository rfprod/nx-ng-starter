{
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "../../dist/libs/client-testing-e2e",
    "rootDir": "./src",
    "sourceMap": false,
    "tsBuildInfoFile": "../../dist/libs/client-testing-e2e/tsconfig.lib.tsbuildinfo",
    "types": ["cypress", "node"]
  },
  "extends": "./tsconfig.json",
  "include": ["./src/**/*.ts"]
}
