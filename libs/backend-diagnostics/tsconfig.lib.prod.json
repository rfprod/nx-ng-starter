{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "rootDir": "./src"
  },
  "extends": "./tsconfig.lib.json",
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
